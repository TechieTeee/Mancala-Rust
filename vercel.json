{
  "version": 2,
  "buildCommand": "export PATH=\"/rust/bin:$PATH\" && rustup target add wasm32-unknown-unknown && curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh && wasm-pack build --target web --out-dir pkg",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/pkg/(.*\\.wasm)$",
      "headers": {
        "Content-Type": "application/wasm"
      }
    },
    {
      "src": "/pkg/(.*\\.js)$",
      "headers": {
        "Content-Type": "application/javascript"
      }
    },
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
